page {
  background: #f4f6f4;
  color: #1f2a26;
  font-size: 30rpx;
  line-height: 1.5;
  --primary: #0f6e56;
  --primary-light: #e3f1ec;
  --accent: #d9862c;
  --danger: #c0392b;
  --muted: #7a827e;
  --card: #ffffff;
  --border: #e4e8e6;
}
.page { padding: 24rpx 28rpx 60rpx; }
.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.card-title { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.muted { color: var(--muted); font-size: 26rpx; }
.am { font-size: 40rpx; font-weight: 500; }
.rom { color: var(--primary); font-size: 26rpx; }
.zh { font-size: 28rpx; }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.grow { flex: 1; }
.btn {
  background: var(--primary);
  color: #fff;
  border-radius: 14rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
  margin-top: 16rpx;
}
.btn::after { border: none; }
.btn.outline { background: #fff; color: var(--primary); border: 2rpx solid var(--primary); }
.btn.accent { background: var(--accent); }
.btn.small { padding: 12rpx 24rpx; font-size: 26rpx; display: inline-block; margin-top: 0; }
.btn[disabled] { opacity: 0.5; }
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--primary-light);
  color: var(--primary);
  margin-right: 8rpx;
}
.tag.warn { background: #fdf0e3; color: var(--accent); }
.tag.gray { background: #eef0ef; color: var(--muted); }
.progress-bar { height: 14rpx; background: #e6ebe9; border-radius: 999rpx; overflow: hidden; }
.progress-bar .fill { height: 100%; background: var(--primary); border-radius: 999rpx; }
.divider { height: 2rpx; background: var(--border); margin: 20rpx 0; }
.list-item { padding: 20rpx 0; border-bottom: 2rpx solid var(--border); }
.list-item:last-child { border-bottom: none; }
.empty { text-align: center; color: var(--muted); padding: 60rpx 0; }
.section-title { font-size: 28rpx; color: var(--muted); margin: 28rpx 0 12rpx; }
textarea.input, input.input {
  width: 100%;
  box-sizing: border-box;
  background: #f7f9f8;
  border: 2rpx solid var(--border);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
textarea.input { min-height: 160rpx; }
