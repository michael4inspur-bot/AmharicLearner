/* 计划页：目标卡 + AI 调整卡 + 8 张周卡片 */
.pr-list { margin-top: 20rpx; }
.pr { padding: 12rpx 0; }
.pr-title { font-weight: 800; font-size: 28rpx; }
.reset { color: var(--lav-ink); font-size: 26rpx; font-weight: 700; }

.week.past { opacity: 0.72; }
.week.current { border: 3rpx solid var(--accent); }

.wk-head { display: flex; align-items: center; gap: 20rpx; }
.wk-num {
  width: 64rpx; height: 64rpx; border-radius: 24rpx; flex-shrink: 0;
  background: var(--peach); color: var(--accent);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 800;
}
.wk-num.now { background: var(--accent); color: #fff; }
.wk-theme { font-size: 30rpx; font-weight: 800; }
.tag.after { margin-left: 12rpx; margin-right: 0; }

.line { display: flex; align-items: center; gap: 8rpx; margin-top: 14rpx; font-size: 26rpx; }
.gap-top { margin-top: 10rpx; }

.adj {
  margin-top: 18rpx; background: var(--lav); border-radius: 28rpx;
  padding: 20rpx 24rpx; font-size: 26rpx;
}
.adj-title { font-weight: 800; color: var(--lav-ink); margin-bottom: 6rpx; }
