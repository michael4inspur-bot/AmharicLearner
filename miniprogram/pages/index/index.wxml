<view class="page">
  <view class="hero">
    <view class="row between">
      <view>
        <view class="hero-am">{{greet.am}}</view>
        <view class="hero-rom">{{greet.rom}} · {{greet.zh}}</view>
      </view>
      <view class="streak" bindtap="goProfile">
        <view class="streak-num">{{streak}}</view>
        <view class="streak-label">连续天</view>
      </view>
    </view>
    <view class="hero-week" bindtap="goPlan">
      <view class="row between">
        <text>第 {{pos.week}} 周 · 第 {{pos.day}} 天</text>
        <text class="link">看计划 ›</text>
      </view>
      <view class="hero-theme">{{week.theme}}</view>
      <view class="progress-bar light"><view class="fill" style="width:{{weekPct}}%"></view></view>
    </view>
  </view>

  <view class="card">
    <view class="row between">
      <view class="card-title">今天 {{minutes}} / {{goal}} 分钟</view>
      <view class="muted">{{doneCount}}/{{requiredCount}} 项完成</view>
    </view>
    <view class="progress-bar"><view class="fill" style="width:{{minutePct}}%"></view></view>
    <view class="muted" style="margin-top:12rpx">到期卡片 {{due}} 张 · 已学 {{total}} 词</view>
  </view>

  <view class="card">
    <view class="card-title">今日任务</view>
    <view class="task {{item.done ? 'done' : ''}}" wx:for="{{tasks}}" wx:key="title" data-idx="{{index}}" bindtap="onTask">
      <view class="task-check">{{item.done ? '✓' : ''}}</view>
      <view class="grow">
        <view class="task-title">{{item.title}} <text class="tag gray" wx:if="{{item.optional}}">自选</text></view>
        <view class="muted">{{item.extra || item.desc}}</view>
      </view>
      <view class="muted">{{item.minutes}}′</view>
    </view>
  </view>

  <view class="card" wx:if="{{overrides}}">
    <view class="card-title">AI 调整中的计划</view>
    <view class="muted">{{overrides.summary}}</view>
    <view class="muted" style="margin-top:8rpx">本周任务：{{overrides.mission_this_week}}</view>
  </view>

  <view class="card">
    <view class="card-title">为什么这周学这个</view>
    <view class="zh">{{week.why}}</view>
    <view class="divider"></view>
    <view class="muted">本周目标：{{week.goal}}</view>
  </view>

  <view class="card row between" bindtap="goSearch">
    <view>
      <view class="card-title">查词句</view>
      <view class="muted">现场急用：输中文马上找到怎么说</view>
    </view>
    <view class="am">🔍</view>
  </view>

  <view class="card row between" bindtap="goFidel">
    <view>
      <view class="card-title">Fidel 字母表</view>
      <view class="muted">本周学第 {{week.fidelGroup}} 批</view>
    </view>
    <view class="am">ፊደል</view>
  </view>

  <view class="card">
    <view class="muted">每日一句</view>
    <view class="am">{{tip.am}}</view>
    <view class="rom">{{tip.rom}} · {{tip.zh}}</view>
  </view>
</view>
