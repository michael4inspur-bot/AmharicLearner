.login { min-height: 100vh; background: var(--bg); padding: 120rpx 40rpx 80rpx; box-sizing: border-box; }
.hero { text-align: center; margin-bottom: 40rpx; }
.hero-am { font-size: 120rpx; line-height: 1.1; }
.hero-title { font-size: 40rpx; font-weight: 800; margin-top: 8rpx; }
.hero-sub { color: var(--muted-2); font-size: 26rpx; margin-top: 8rpx; }
.err { color: var(--danger); font-size: 26rpx; margin-top: 12rpx; }
.center { text-align: center; margin-top: 20rpx; }
.link { color: var(--accent); font-weight: 700; font-size: 26rpx; }
