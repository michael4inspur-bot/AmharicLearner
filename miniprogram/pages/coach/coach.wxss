.tabs { display: flex; background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; overflow: hidden; }
.tab { flex: 1; text-align: center; padding: 18rpx 0; font-size: 28rpx; color: var(--muted); }
.tab.on { color: var(--primary); font-weight: 600; border-bottom: 4rpx solid var(--primary); }
.score { font-size: 48rpx; font-weight: 700; color: var(--primary); }
.enc { margin-top: 14rpx; padding: 14rpx 18rpx; background: var(--primary-light); border-radius: 12rpx; color: var(--primary); font-size: 26rpx; }
.li { padding: 6rpx 0; font-size: 28rpx; }
.li.ok { color: var(--primary); }
.li.warn { color: var(--accent); }
.rec { padding: 14rpx 0; border-bottom: 2rpx solid var(--border); }
.rec:last-child { border-bottom: none; }
.rec-title { font-weight: 500; }
.chat { height: 55vh; background: #fff; border-radius: 20rpx; padding: 20rpx; box-sizing: border-box; margin-bottom: 12rpx; }
.msg { display: flex; margin-bottom: 16rpx; }
.msg.user { justify-content: flex-end; }
.msg .bubble { max-width: 85%; padding: 16rpx 20rpx; border-radius: 16rpx; background: #f1f4f2; white-space: pre-wrap; word-break: break-all; font-size: 28rpx; }
.msg.user .bubble { background: var(--primary); color: #fff; }
.quick { white-space: nowrap; margin-bottom: 12rpx; }
.qbtn { display: inline-block; background: #fff; border: 2rpx solid var(--border); border-radius: 999rpx; padding: 10rpx 22rpx; margin-right: 12rpx; font-size: 24rpx; color: var(--primary); }
.composer { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.composer .input { flex: 1; }
