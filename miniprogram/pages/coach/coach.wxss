/* 子 Tab 胶囊 */
.segs { display: flex; background: var(--peach); border-radius: 999rpx; padding: 8rpx; margin-bottom: 28rpx; }
.seg { flex: 1; text-align: center; padding: 18rpx 0; font-size: 28rpx; font-weight: 700; color: var(--muted-2); border-radius: 999rpx; }
.seg.on { background: var(--accent); color: #fff; box-shadow: 0 12rpx 30rpx rgba(194, 65, 12, 0.26); }
.seg:active { opacity: 0.85; }

/* 诊断分数环 */
.ring {
  width: 120rpx; height: 120rpx; border-radius: 999rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.ring-in {
  width: 92rpx; height: 92rpx; border-radius: 999rpx; background: var(--card);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 800; color: var(--mint-deep);
}
.enc { margin-top: 20rpx; padding: 18rpx 24rpx; background: var(--peach); border-radius: 32rpx; color: var(--accent); font-size: 26rpx; font-weight: 700; }

/* 优势 / 薄弱 / 风险行 */
.li { display: flex; align-items: flex-start; gap: 16rpx; padding: 10rpx 0; font-size: 28rpx; }
.li-ic { width: 44rpx; height: 44rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.li-ic.mint { background: var(--mint); }
.li-ic.peach { background: var(--peach); }
.li-dot { width: 12rpx; height: 12rpx; border-radius: 999rpx; background: var(--accent-soft); flex-shrink: 0; margin: 16rpx 16rpx 0 16rpx; }

.rec { padding: 18rpx 0; border-bottom: 2rpx solid #F5EADF; }
.rec:last-child { border-bottom: none; }
.rec-title { font-weight: 700; font-size: 28rpx; margin-bottom: 6rpx; }

.day-row { display: flex; align-items: center; gap: 16rpx; padding: 12rpx 0; font-size: 28rpx; }
.day-num {
  width: 48rpx; height: 48rpx; border-radius: 18rpx; background: var(--lav); color: var(--lav-ink);
  display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 800; flex-shrink: 0;
}

/* AI 生成内容标识与反馈入口（AIGC 合规） */
.tag.ai { background: var(--lav); color: var(--lav-ink); margin-top: 8rpx; }
.ai-note { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; font-size: 22rpx; color: var(--muted-2); margin-top: 16rpx; line-height: 1.5; }
.fb { margin: 0; padding: 4rpx 18rpx; font-size: 22rpx; line-height: 1.6; background: var(--lav); color: var(--lav-ink); border-radius: 999rpx; flex-shrink: 0; }
.fb::after { border: none; }
