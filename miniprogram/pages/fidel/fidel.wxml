<view class="page no-tab">
  <view class="fd-head">
    <view class="fd-title">Fidel 字母表</view>
    <view class="muted">每个辅音有 7 个「序」（元音变体）：先记基础字（1 序），再看同一行的规律。</view>
  </view>

  <scroll-view scroll-x class="groups">
    <view class="gbtn {{group===g ? 'on' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:for-item="g" wx:key="*this" data-g="{{g}}" bindtap="pickGroup">第 {{g}} 批</view>
    <view class="gbtn {{group===0 ? 'on' : ''}}" data-g="0" bindtap="pickGroup">全部</view>
  </scroll-view>

  <block wx:if="{{mode==='table'}}">
    <view class="card fd-card">
      <view class="row gap fd-card-head">
        <view class="tag mint" wx:if="{{done}}">本批已通过自测</view>
        <view class="muted grow">左列是辅音，右侧七列是元音序</view>
      </view>
      <scroll-view scroll-x>
        <view class="grid">
          <view class="hrow">
            <view class="hcell first muted">辅音</view>
            <view class="hcell muted" wx:for="{{orderLabels}}" wx:key="*this">{{item}}</view>
          </view>
          <view class="frow" wx:for="{{rows}}" wx:for-item="c" wx:key="base">
            <view class="cell first">
              <view class="c-name">{{c.name}}</view>
              <view class="muted tiny">{{c.example}}</view>
            </view>
            <view class="cell" wx:for="{{c.forms}}" wx:for-item="f" wx:key="ch">
              <view class="am f-ch">{{f.ch}}</view>
              <view class="f-rom">{{f.rom}}</view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
    <view class="btn" bindtap="startQuiz">认读自测（10 题）</view>
  </block>

  <block wx:if="{{mode==='quiz'}}">
    <view class="row between qz-head">
      <view class="qz-count">{{qIdx + 1}} / {{qTotal}}</view>
      <view class="qz-score">得分 {{qScore}}</view>
    </view>
    <view class="card qbox">
      <view class="am big">{{q.ch}}</view>
      <view class="muted">这个字怎么读？</view>
    </view>
    <view class="opt {{qPicked ? (item.rom === q.rom ? 'right pulse' : (item.rom === qPicked ? 'wrong pulse' : 'dim')) : ''}}"
          wx:for="{{q.options}}" wx:key="rom" data-rom="{{item.rom}}" bindtap="pickQ">{{item.rom}}</view>
  </block>

  <view class="card result-card" wx:if="{{mode==='result'}}">
    <view class="am result-am">{{pct >= 70 ? 'ጥሩ ስራ!' : 'ችግር የለም'}}</view>
    <view class="result-score">{{pct}}%</view>
    <view class="stars result-stars" wx:if="{{earned}}">
      <x-icon name="star" size="32" color="#F59E0B" />
      <text>+{{earned}} 星</text>
    </view>
    <view class="muted">{{pct >= 70 ? '本批字母已掌握，计划里会打钩。' : '再看一遍表格，明天再测。'}}</view>
    <view class="btn outline" bindtap="backTable">回到字母表</view>
  </view>
</view>
