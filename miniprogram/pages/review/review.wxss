/* 闪卡复习：方案 C */
.rv-head { margin-bottom: 20rpx; gap: 20rpx; }
.rv-title { font-size: 44rpx; font-weight: 800; line-height: 1.2; }

/* 桃色分段模式胶囊 */
.modes { display: flex; background: var(--peach); border-radius: 999rpx; padding: 8rpx; flex-shrink: 0; }
.mode { padding: 14rpx 22rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 700; color: var(--muted-2); }
.mode.on { background: var(--accent); color: #FFFFFF; font-weight: 800; }

/* 分段进度条 */
.segs { display: flex; gap: 10rpx; margin-bottom: 24rpx; }
.seg { flex: 1; height: 16rpx; border-radius: 999rpx; background: var(--peach); transition: background 240ms ease; }
.seg.done { background: var(--mint-ink); }
.seg.now { background: var(--accent); }

/* 翻面卡片 */
.fc {
  position: relative; height: 720rpx; margin-bottom: 28rpx;
  transform: rotateY(0deg);
  transition: transform 360ms ease;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
}
.fc.is-flipped { transform: rotateY(180deg); }
.fc-face {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: var(--card); border-radius: 64rpx; box-shadow: var(--shadow);
  padding: 72rpx 48rpx; box-sizing: border-box;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  overflow: hidden;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}
.fc-back { transform: rotateY(180deg); }

.deco { position: absolute; border-radius: 999rpx; }
.deco-mint { left: -80rpx; bottom: -80rpx; width: 320rpx; height: 320rpx; background: var(--mint); }
.deco-lav { right: -60rpx; top: 120rpx; width: 200rpx; height: 200rpx; background: var(--lav); }

.fc-unit {
  position: absolute; top: 36rpx; left: 40rpx; max-width: 440rpx;
  font-size: 24rpx; font-weight: 700; color: var(--mint-ink);
  background: var(--mint); border-radius: 999rpx; padding: 10rpx 20rpx;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.fc-body { position: relative; width: 100%; display: flex; flex-direction: column; align-items: center; gap: 16rpx; text-align: center; }
.fc-play {
  width: 192rpx; height: 192rpx; border-radius: 999rpx; background: var(--mint-ink);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 0 0 24rpx var(--mint); margin-bottom: 16rpx;
}
.fc-play:active { transform: scale(0.94); }
.fc-am { font-size: 92rpx; line-height: 1.15; }
.fc-rom { font-size: 28rpx; color: var(--muted); letter-spacing: 0.5rpx; }
.fc-zh { font-size: 48rpx; font-weight: 800; }
.fc-zh.big { font-size: 56rpx; }
.fc-note { font-size: 26rpx; color: var(--muted-2); }
.fc-hint { font-size: 26rpx; color: var(--muted); margin-top: 8rpx; }
.fc-foot { position: absolute; left: 0; right: 0; bottom: 36rpx; text-align: center; font-size: 24rpx; color: var(--muted); }
.fc-tools { display: flex; gap: 24rpx; margin-top: 20rpx; }

/* 评分胶囊 */
.grades { display: flex; gap: 20rpx; }
.g {
  flex: 1; height: 124rpx; border-radius: 40rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx;
}
.g:active { transform: scale(0.97); }
.g.peach { background: var(--peach); color: var(--accent); }
.g.peach .g-sub { color: var(--muted-2); }
.g.lav { background: var(--lav); color: var(--lav-ink); }
.g.lav .g-sub { color: var(--lav-muted); }
.g.mint { flex: 1.4; background: var(--mint-ink); color: #FFFFFF; box-shadow: 0 20rpx 48rpx rgba(47, 122, 94, 0.3); }
.g.mint .g-sub { color: #FFFFFF; opacity: 0.85; }
.g-main { font-size: 30rpx; font-weight: 800; }
.g-sub { font-size: 22rpx; }
.grades-hint { text-align: center; color: var(--muted); font-size: 26rpx; padding: 34rpx 0; }

/* 清空状态 */
.done-card { text-align: center; padding: 64rpx 40rpx; }
.done-am { font-size: 64rpx; line-height: 1.3; }
.done-stars { margin: 18rpx 0 10rpx; font-size: 26rpx; }
.done-title { font-size: 32rpx; font-weight: 800; margin-bottom: 10rpx; }
