<view class="page">
  <view class="row between" style="margin-bottom:16rpx">
    <view class="muted">到期 {{queue.length}} · 已学 {{stats.total}} · 熟练 {{stats.mature}}</view>
    <view class="btn outline small" bindtap="toggleMode">{{mode==='am' ? '看阿→想中' : '看中→想阿'}}</view>
  </view>

  <block wx:if="{{current}}">
    <view class="flashcard" bindtap="flip">
      <view class="tag warn" wx:if="{{current.again}}">刚才忘了，再来一次</view>
      <block wx:if="{{mode==='am'}}">
        <view class="fc-am">{{current.am}}</view>
        <view class="fc-rom">{{current.rom}}</view>
        <view class="fc-answer" wx:if="{{flipped}}">
          <view class="fc-zh">{{current.zh}}</view>
          <view class="muted" wx:if="{{current.note}}">{{current.note}}</view>
        </view>
      </block>
      <block wx:else>
        <view class="fc-zh big">{{current.zh}}</view>
        <view class="fc-answer" wx:if="{{flipped}}">
          <view class="fc-am">{{current.am}}</view>
          <view class="fc-rom">{{current.rom}}</view>
          <view class="muted" wx:if="{{current.note}}">{{current.note}}</view>
        </view>
      </block>
      <view class="muted" wx:if="{{!flipped}}" style="margin-top:30rpx">先在心里说出答案，再点击翻面</view>
    </view>

    <view class="grades" wx:if="{{flipped}}">
      <view class="g bad" data-g="1" bindtap="grade">忘了<text class="sub">10 分钟后</text></view>
      <view class="g mid" data-g="3" bindtap="grade">模糊<text class="sub">较快再见</text></view>
      <view class="g good" data-g="5" bindtap="grade">记得<text class="sub">间隔拉长</text></view>
    </view>
  </block>

  <view class="card" wx:else>
    <view class="empty" wx:if="{{stats.total === 0}}">
      还没有卡片。先去"课程"学一个单元，点"加入闪卡复习"。
      <view class="btn" bindtap="goLessons">去课程</view>
    </view>
    <view class="empty" wx:else>
      <view class="am">ጥሩ ስራ!</view>
      <view>今天的复习清空了 · 对 {{sessionCorrect}} / 错 {{sessionWrong}}</view>
      <view class="muted" style="margin-top:8rpx">{{stats.newWaiting ? '还有 ' + stats.newWaiting + ' 张新卡按每日上限明天放出。' : '下一批卡片会按遗忘曲线自动到期。'}}想加练可以做综合小测。</view>
      <view class="btn outline" bindtap="goQuiz">综合小测</view>
    </view>
  </view>

  <view class="muted" style="text-align:center">本次：{{done}} 张 · 对 {{sessionCorrect}} · 错 {{sessionWrong}}</view>
</view>
