<view class="page no-tab">
  <block wx:if="{{!finished}}">
    <view class="row between qz-head">
      <view class="qz-count">{{idx + 1}} / {{questions.length}}</view>
      <view class="qz-score">得分 {{score}}</view>
    </view>
    <view class="progress-bar qz-bar"><view class="fill" style="width:{{idx / questions.length * 100}}%"></view></view>

    <view class="card qcard">
      <block wx:if="{{current.listen}}">
        <view class="q-play" bindtap="playCurrent"><x-icon name="speaker" size="72" color="#FFFFFF" /></view>
        <view class="q-kind">听音选意思</view>
        <view class="muted">听不清可以再点一次</view>
      </block>
      <block wx:else>
        <view class="q-kind">{{current.promptAm ? '这是什么意思？' : '阿姆哈拉语怎么说？'}}</view>
        <view class="row q-am-row" wx:if="{{current.promptAm}}">
          <view class="am q-am">{{current.promptAm}}</view>
          <view class="icon-btn" catchtap="playCurrent"><x-icon name="speaker" size="34" color="#2F7A5E" /></view>
        </view>
        <view class="rom" wx:if="{{current.promptRom}}">{{current.promptRom}}</view>
        <view class="q-zh" wx:if="{{current.promptZh}}">{{current.promptZh}}</view>
      </block>
    </view>

    <view class="opt {{picked ? (item.id === current.answer ? 'right pulse' : (item.id === picked ? 'wrong pulse' : 'dim')) : ''}}"
          wx:for="{{current.options}}" wx:key="id" data-id="{{item.id}}" bindtap="pick">{{item.text}}</view>

    <view class="card ex-card" wx:if="{{picked}}">
      <view class="row gap">
        <view class="square {{correct ? 'mint' : 'peach'}}">
          <x-icon name="{{correct ? 'check' : 'refresh'}}" size="36" color="{{correct ? '#2F7A5E' : '#C2410C'}}" />
        </view>
        <view class="grow">
          <view class="ex-title {{correct ? 'ok' : 'no'}}">{{correct ? '正确' : '答错了'}}</view>
          <view class="muted">{{current.explain}}</view>
        </view>
      </view>
      <view class="row q-am-row ex-am" wx:if="{{current.listen}}">
        <view class="am">{{current.audioText}}</view>
        <view class="icon-btn" catchtap="playCurrent"><x-icon name="speaker" size="34" color="#2F7A5E" /></view>
      </view>
      <view class="btn" bindtap="next">{{idx + 1 >= questions.length ? '看结果' : '下一题'}}</view>
    </view>
  </block>

  <view class="card result-card" wx:else>
    <view class="am result-am">{{pct >= 80 ? 'በጣም ጥሩ!' : pct >= 60 ? 'ጥሩ ነው' : 'ችግር የለም'}}</view>
    <view class="result-line">
      <text class="result-score">{{score}}</text>
      <text class="result-total">/ {{questions.length}}</text>
    </view>
    <view class="stars result-stars">
      <x-icon name="star" size="32" color="#F59E0B" />
      <text>+{{earned}} 星</text>
    </view>
    <view class="muted">{{pct >= 80 ? '非常好，可以进入下一单元。' : pct >= 60 ? '不错。错的词已排到更早复习。' : '没关系，错题会更频繁出现在闪卡里，明天再测一次。'}}</view>
    <view class="btn" bindtap="again">再测一次</view>
    <view class="btn outline" bindtap="back">返回</view>
  </view>
</view>
