/* 查词句 · 方案 C */
.searchbox { position: relative; }
.search-icon {
  position: absolute; left: 28rpx; top: 0; bottom: 0;
  display: flex; align-items: center; z-index: 1;
}
.search-input { padding-left: 78rpx; border-radius: 999rpx; padding-top: 26rpx; padding-bottom: 26rpx; }
.hint { font-size: 24rpx; color: var(--muted); margin: 16rpx 4rpx 0; }

.chips { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 12rpx; }
.chip { margin-right: 0; padding: 14rpx 28rpx; font-size: 26rpx; box-shadow: var(--shadow-sm); }
.chip:active { transform: scale(0.96); }

/* 结果行：与单元详情词句行一致 */
.word-row {
  background: var(--card);
  border-radius: 44rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: var(--shadow-sm);
  animation: rise 280ms ease-out both;
}
.word-am { font-size: 48rpx; line-height: 1.25; }
.word-row .rom { margin-top: 4rpx; }
.word-row .zh { margin-top: 4rpx; }
.note { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }
.unit-link {
  display: inline-flex; align-items: center; gap: 6rpx;
  margin-top: 12rpx; font-size: 22rpx; color: var(--muted);
}
.unit-link:active { opacity: 0.6; }
