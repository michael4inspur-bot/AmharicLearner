<view class="page no-tab">
  <view class="searchbox">
    <view class="search-icon"><x-icon name="search" size="34" color="#B08A78" /></view>
    <input class="input search-input" value="{{q}}" placeholder="{{L.searchPlaceholder}}" placeholder-class="ph" bindinput="onInput" bindconfirm="onConfirm" confirm-type="search" focus />
  </view>
  <view class="hint">{{L.searchHint}}<text class="syn-tag" wx:if="{{voiceNote}}">{{voiceNote}}</text></view>

  <block wx:if="{{!q && recent.length}}">
    <view class="section-title">最近搜索</view>
    <view class="chips">
      <view class="tag white chip" wx:for="{{recent}}" wx:key="*this" data-q="{{item}}" bindtap="useRecent">{{item}}</view>
    </view>
  </block>

  <view class="card" wx:if="{{q && !results.length}}">
    <view class="empty">没找到。换个说法再试，或者用拼写片段搜。</view>
  </view>

  <view class="word-row" wx:for="{{results}}" wx:key="id">
    <view class="grow" data-text="{{item.text}}" bindlongpress="copy">
      <view class="{{tc}} word-am">{{item.text}}</view>
      <view class="rom" wx:if="{{item.rom}}">{{item.rom}}</view>
      <view class="zh">{{item.zh}}</view>
      <view class="note" wx:if="{{item.note}}">{{item.note}}</view>
      <view class="unit-link" data-unit="{{item.unit}}" catchtap="openUnit">
        <text>{{item.unitTitle}}</text>
        <x-icon name="chevron-right" size="22" color="#B08A78" />
      </view>
    </view>
    <view class="square mint" wx:if="{{audio}}" data-text="{{item.text}}" catchtap="play">
      <x-icon name="speaker" size="36" color="#2F7A5E" />
    </view>
    <view class="square lav" data-id="{{item.id}}" catchtap="addCard">
      <x-icon name="plus" size="36" color="#4C3D8F" />
    </view>
  </view>
</view>
