.stats { display: flex; flex-wrap: wrap; }
.st { width: 33.33%; text-align: center; padding: 14rpx 0; }
.n { font-size: 40rpx; font-weight: 700; color: var(--primary); }
.l { font-size: 22rpx; color: var(--muted); }
.sl { width: 260rpx; margin: 0 12rpx 0 0; }
.link { color: var(--primary); }
.usage { margin-top: 12rpx; }
.usage-line { font-size: 26rpx; color: var(--primary); }
.team-row { display: flex; flex-wrap: wrap; align-items: baseline; }
.team-id { font-family: monospace; font-size: 26rpx; color: var(--primary); margin-right: 16rpx; }
.team-nums { font-size: 26rpx; flex: 1; }
.team-date { width: 100%; font-size: 22rpx; margin-top: 4rpx; }
