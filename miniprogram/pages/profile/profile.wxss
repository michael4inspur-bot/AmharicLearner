/* 六宫格状态块 */
.grid6 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-bottom: 24rpx; }
.cell { border-radius: 32rpx; padding: 24rpx 20rpx; animation: rise 280ms ease-out both; }
.cell.peach { background: var(--peach); }
.cell.mint { background: var(--mint); }
.cell.lav { background: var(--lav); }
.cell.white { background: var(--card); box-shadow: var(--shadow-sm); }
.cell-top { display: flex; align-items: center; gap: 8rpx; }
.cell .n { font-size: 44rpx; font-weight: 800; line-height: 1.1; }
.cell .l { font-size: 22rpx; margin-top: 6rpx; }
.cell.peach .n { color: var(--accent); }
.cell.peach .l { color: var(--muted-2); }
.cell.mint .n { color: var(--mint-deep); }
.cell.mint .l { color: var(--mint-ink); }
.cell.lav .n { color: var(--lav-ink); }
.cell.lav .l { color: var(--lav-muted); }
.cell.white .n { color: var(--ink); }
.cell.white .l { color: var(--muted); }

/* 徽章墙 */
.badges { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24rpx 12rpx; margin-top: 28rpx; }
.bd { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8rpx; }
.bd-ic {
  width: 92rpx; height: 92rpx; border-radius: 999rpx; background: #F7F0E9;
  display: flex; align-items: center; justify-content: center;
}
.bd-ic.on { background: var(--peach); }
.bd-name { font-size: 22rpx; font-weight: 800; color: var(--ink); line-height: 1.25; }
.bd-name.off { font-weight: 600; color: var(--muted); }
.bd-hint { font-size: 20rpx; line-height: 1.3; }

/* 设置 */
.sl { width: 240rpx; margin: 0 12rpx 0 0; }
.link { color: var(--accent); font-weight: 700; }

/* 用量 */
.usage { margin-top: 20rpx; }
.usage-row { display: flex; gap: 12rpx; margin-bottom: 12rpx; }
.usage-cell { flex: 1; background: var(--mint); border-radius: 24rpx; padding: 16rpx; text-align: center; }
.usage-n { font-size: 26rpx; font-weight: 800; color: var(--mint-deep); }
.usage-l { font-size: 20rpx; color: var(--mint-ink); margin-top: 2rpx; }

/* 团队用量 */
.team-id { font-size: 26rpx; font-weight: 800; color: var(--accent); }
.team-date { font-size: 22rpx; }
.team-nums { font-size: 24rpx; margin-top: 6rpx; }
