.item { padding: 16rpx 0; border-bottom: 2rpx solid #F5EADF; }
.item:last-child { border-bottom: none; }
.item-type { font-weight: 800; font-size: 28rpx; line-height: 1.45; }
.item-use { color: var(--muted); font-size: 26rpx; margin-top: 6rpx; line-height: 1.55; }
.li { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 12rpx; }
.li-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--lav-ink); margin-top: 16rpx; flex-shrink: 0; }
.zh { font-size: 26rpx; line-height: 1.6; color: var(--ink); }
.center { text-align: center; margin-top: 24rpx; }
